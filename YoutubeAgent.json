        "jsCode": "const candidates = items[0].json.candidates || [];\n\nif (candidates.length === 0) {\n  throw new Error(\"No candidates found.\");\n}\n\nconst parts = candidates[0].content?.parts || [];\n\nconst inlinePart = parts.find(p => p.inlineData && p.inlineData.data);\n\nif (!inlinePart) {\n  throw new Error(\"No inlineData image found in parts.\");\n}\n\n// Pass the image data forward\nreturn [\n  {\n    json: {\n      base64Image: inlinePart.inlineData.data\n    }\n  }\n];\n"
      },
